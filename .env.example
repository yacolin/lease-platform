# ============================================================================
# docker compose 环境变量示例（复制为 .env 并按需修改）
# ============================================================================
# MySQL root 密码（同时用于应用连接；本地开发默认 123456）
DB_PASSWORD=123456
# Redis 密码（默认无密码留空）
REDIS_PASSWORD=
# JWT 签名密钥（Base64，>= 256 bit；生产必须设置）
JWT_SECRET=Iyh/J3RcrpgUbprqYJmbNC6YV5DXAV9q9AUsKuXn7HQ82fNXFakPWoCYWdZuDEbs
# 微信小程序（生产必填）
WECHAT_APPID=
WECHAT_SECRET=
# 微信支付（生产按需填写，留空则充值走 mock-pay）
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_MCH_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=
